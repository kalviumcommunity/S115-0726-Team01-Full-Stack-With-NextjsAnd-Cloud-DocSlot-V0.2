generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  phone     String?
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  doctor    Doctor?
  patient   Patient?
}

model Doctor {
  id              String        @id @default(cuid())
  userId          String        @unique
  specialization  String
  qualifications  String?
  bio             String?
  consultationFee Decimal       @db.Decimal(10, 2)
  status          DoctorStatus  @default(PENDING)
  timezone        String        @default("UTC")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  appointments    Appointment[]
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedules       Schedule[]
  availabilityExceptions AvailabilityException[]
}

model Patient {
  id           String        @id @default(cuid())
  userId       String        @unique
  dateOfBirth  DateTime?
  gender       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Schedule {
  id           String            @id @default(cuid())
  doctorId     String
  dayOfWeek    Int
  startTime    String
  endTime      String
  slotDuration Int               @default(30)
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  slots        AppointmentSlot[]
  doctor       Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, dayOfWeek])
}

model AppointmentSlot {
  id          String       @id @default(cuid())
  doctorId    String
  scheduleId  String?
  exceptionId String?
  date        DateTime
  startTime   String
  endTime     String
  isBooked    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  appointments Appointment[]
  schedule    Schedule?    @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  exception   AvailabilityException? @relation(fields: [exceptionId], references: [id], onDelete: Cascade)

  @@index([doctorId, date, startTime])
  @@index([doctorId, date])
}

model Appointment {
  id        String            @id @default(cuid())
  patientId String
  doctorId  String
  slotId    String
  status    AppointmentStatus @default(CONFIRMED)
  reason    String?
  cancellationReason String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  doctor    Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient   Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  slot      AppointmentSlot   @relation(fields: [slotId], references: [id], onDelete: Cascade)
  auditLogs AppointmentAuditLog[]

  @@index([patientId, createdAt])
  @@index([doctorId, createdAt])
  @@index([slotId])
}

model AvailabilityException {
  id        String            @id @default(cuid())
  doctorId  String
  type      AvailabilityExceptionType
  startDate DateTime
  endDate   DateTime
  startTime String?
  endTime   String?
  reason    String?
  createdAt DateTime          @default(now())
  doctor    Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  slots     AppointmentSlot[]

  @@index([doctorId, startDate, endDate])
}

model AppointmentAuditLog {
  id            String   @id @default(cuid())
  appointmentId String
  action        AppointmentAuditAction
  actorRole     Role?
  actorId       String?
  reason        String?
  fromSlotId    String?
  toSlotId      String?
  createdAt     DateTime @default(now())
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
}

enum Role {
  DOCTOR
  PATIENT
}

enum DoctorStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum AvailabilityExceptionType {
  LEAVE
  HOLIDAY
  BLOCKED
  EXTRA_HOURS
}

enum AppointmentAuditAction {
  BOOKED
  CANCELLED_BY_PATIENT
  CANCELLED_BY_DOCTOR
  RESCHEDULED
  COMPLETED
  MARKED_NO_SHOW
}
